# Every variable is optional: the defaults below are what the app uses when it is unset.
# The apps do not load this file themselves. Export the variables in your shell
# (for example `PORT=4100 npm run dev`) or copy the database lines to apps/api/.env,
# which the Prisma CLI reads. The password is the documented local-only dev default.

# --- API (apps/api) ---------------------------------------------------------
# Database used by the API and by prisma migrate/seed.
DATABASE_URL=postgresql://imaging:imaging@localhost:5432/imaging
# Database used by the API tests, the contention script and the e2e suite (NODE_ENV=test).
DATABASE_URL_TEST=postgresql://imaging:imaging@localhost:5432/imaging_test
# Port the API listens on. Change it if 4000 is busy.
PORT=4000
# The one browser origin CORS allows (the Vite dev server by default).
WEB_ORIGIN=http://localhost:5173
# Set to false to remove /docs and /docs/openapi.json.
API_DOCS_ENABLED=true
# Dev-only local DICOM import: where files are copied and `local:<uuid>` keys resolve
# (default <repo>/local-dicom; git-ignored). Read by the API and `npm run import:dicom`.
# LOCAL_DICOM_DIR=/absolute/path/to/local-dicom

# --- Web dev server (apps/web) ----------------------------------------------
# Where the Vite dev server proxies /api. Must match PORT when you change it.
API_PROXY_TARGET=http://localhost:4000

# --- Playwright (npm run test:e2e) ------------------------------------------
# Port of the API process that Playwright starts. Change it if 4000 is busy.
E2E_API_PORT=4000
